{
  // Draftwick settings.
  //
  // Only the settings you want to change need to be listed here; anything missing uses its
  // default. To change one, remove the "//" in front of it, edit the value, save this file, then
  // choose Settings > Reload settings in Draftwick.

  // How long to wait after you stop typing before a draft is saved, in milliseconds.
  // Every keystroke restarts the wait. Allowed range: 500 (half a second) to 30000 (30 seconds).
  // A longer wait means fewer writes; a shorter one means less is lost if the app or the
  // computer stops suddenly. Drafts are always saved when you switch drafts or quit.
  // Default: 5000 (5 seconds).
  // "autosave_delay_ms": 5000

  // The colour theme: "system" follows your operating system's light or dark setting, "dark" and
  // "light" always use that one. Default: "system".
  // "theme": "system"

  // The size of the text in the editor, in pixels. Allowed range: 8 to 48. Default: 14.
  // "font_size": 14

  // The font used in the editor: one font name that is installed on your computer, such as
  // "Fira Code" or "JetBrains Mono". Leave it out to use the system's monospace font.
  // "font_family": "JetBrains Mono"

  // How many characters wide a line is before it wraps onto the next line. This only changes how
  // the text is shown; no line break is added to the file. Allowed range: 20 to 300, or 0 to wrap
  // at the edge of the window. Default: 70.
  // "wrap_column": 70
}
