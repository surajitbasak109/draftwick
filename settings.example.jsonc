{
  // Draftwick settings.
  // List only what you want to change; anything left out uses its default.
  // To change one: remove the "//" in front of it, edit the value, and save.
  // The change applies at once. Settings > Show settings explains each one.

  // How long to wait after you stop typing before a draft is saved (ms).
  // Allowed: 500 to 30000. Default: 5000.
  // "autosave_delay_ms": 5000

  // Colours: "system" follows your operating system, or "dark" or "light".
  // Default: "system".
  // "theme": "system"

  // Editor text size, in pixels. Allowed: 8 to 48. Default: 14.
  // "font_size": 14

  // Editor font: one installed font name. Default: the system monospace font.
  // "font_family": "JetBrains Mono"

  // Characters per line before wrapping (display only, no line breaks added).
  // Allowed: 0 (the window edge), or 20 to 300. Default: 0.
  // "wrap_column": 0

  // Show a line number beside each line. Default: false.
  // "show_line_numbers": false

  // Width of a tab, in characters. Allowed: 2, 4 or 8. Default: 4.
  // "tab_size": 4

  // What Tab types: true for spaces, false for a tab character. Default: true.
  // "translate_tabs_to_spaces": true
}
